<RESULT MODE="XML" ACTION="GETOBJECTS"  VERSION="2"  CHARSET="UTF8" >
<SMARTRULE FIND="RULE_CODE='DQC_CHANGE'" USER="lf.guimaraes" UPDATE_DATE="22/04/2026" UPDATE_TIME="15:21:06" LABEL='DQC Change'>
<T_SMARTRULE CODEFIELDS="RULE_CODE" >
<R_SMARTRULE CODE=",["RULE_CODE","DQC_CHANGE",]"  LOCAL_ID="176292" >
<ACTIVE >Y</ACTIVE>
<CONDITION ></CONDITION>
<DESCRIPTION ></DESCRIPTION>
<IMPACT ><![CDATA[// arg1: controlled object
// arg2: MxControlClauseData clause

// --- Initialize objects ---
securityTest := arg1
clauseCtrlData := arg2

// --- Get field info ---
businessField := getObject("MxBusinessField", clauseCtrlData.BUSINESS_FIELD);
fieldId := businessField.TECH_FIELD

// --- Get class info ---
className := securityTest.getClassname()
classObj  := getObjectByCode("SMARTCLASS", className)
classId   := classObj.id()

// --- Get object ID ---
objectId := securityTest.id()

// --- Fetch latest audit trail ID ---
query := 
  "SELECT A.AUDITTRAIL_ID " +
  "FROM AUDITTRAIL A, AUDITTRAIL_LINK L " +
  "WHERE A.AUDITTRAIL_ID = L.AUDITTRAIL_ID " +
  "AND L.OBJECT_TYPE = " + classId + " " +
  "AND L.OBJECT = " + objectId + " " +
  "ORDER BY A.AUDITTRAIL_ID DESC"

result := getSqlData(query)

if (arraysize(result) = 0) return 0

auditTrailLast := result[0]
auditTrailId    := auditTrailLast[0]
auditTrail       := getObject("MxAuditTrail", auditTrailId)

// --- Check audit trail details ---
foreach auditTrail.AUDITTRAIL_DETAIL do {
  if (auditTrail.FIELD_ID = fieldId) {
    return getListItemId("YES_NO", "Y")
  }
}

return getListItemId("YES_NO", "N")]]></IMPACT>
