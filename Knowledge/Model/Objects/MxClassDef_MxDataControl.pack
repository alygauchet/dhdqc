<SCRIPT ><![CDATA[aData := getObject("MxControlClauseData", obj.ASSESSED_DATA)
tData := getObject("MxControlClauseData", obj.TARGET_DATA)
op := getListItemLabel("DATACONTROL_CLAUSE_OPERATORS", obj.CLAUSE_OPERATOR)

comparison := strcat(aData.NAME[LANGUAGE = 0], " ", op)
if(tData!="") comparison := strcat(comparison, " ", tData.NAME[LANGUAGE = 0])

if(aData!="")return comparison
else return ""]]></SCRIPT>
