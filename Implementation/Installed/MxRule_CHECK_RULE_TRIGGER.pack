<SMARTRULE FIND="RULE_CODE='CHECK_RULE_TRIGGER'" USER="BAMS\aminata.lygauchet" UPDATE_DATE="22/04/2026" UPDATE_TIME="12:06:38" LABEL='Check Rule Trigger'>
<T_SMARTRULE CODEFIELDS="RULE_CODE" >
<R_SMARTRULE CODE=",["RULE_CODE","CHECK_RULE_TRIGGER",]"  LOCAL_ID="183704" >
<ACTIVE >Y</ACTIVE>
<CONDITION ><![CDATA[$,["RULE_CODE","CHECK_RULE_TRIGGER",]^CONDITION]]></CONDITION>
<DESCRIPTION ><![CDATA[This rule ensures: 1) DATA_STRUCTURE is always empty for Object Saved and On Demand triggers; 2) UPDATED_DATA_FLAG is only used for Object Saved trigger (cleared for On Demand and Field Changed).]]></DESCRIPTION>
<IMPACT ><![CDATA[objectSaved  := getListitemId("RULE_TRIGGER_TYPE", 13);
ondemand     := getListitemId("RULE_TRIGGER_TYPE", "ON_DEMAND");
fieldchanged := getListitemId("RULE_TRIGGER_TYPE", 41);

if (obj.first("CONTROLEXECRULE_TRIGGER")) {
    do {
        if ((obj.TRIGGER_TYPE=objectSaved) or (obj.TRIGGER_TYPE=ondemand)) {
            if (obj.DATA_STRUCTURE!="") {
                obj.DATA_STRUCTURE:="";
            }
        }
        if ((obj.TRIGGER_TYPE=ondemand) or (obj.TRIGGER_TYPE=fieldchanged)) {
            if (obj.UPDATED_DATA_FLAG!="") {
                obj.UPDATED_DATA_FLAG:="";
            }
        }
    } while (obj.next("CONTROLEXECRULE_TRIGGER"))
}]]></IMPACT>
